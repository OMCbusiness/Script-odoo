#!/bin/bash

# SCRIPT ADAPTADO PARA UBUNTU 22.04
# Odoo 17 + Python 3.11.9 + PostgreSQL 14 + Nginx + Certbot

ODOO_VERSION="17.0"
PYTHON_VERSION="3.11.9"

# Actualizar sistema
sudo apt update && sudo apt upgrade -y

# Instalar dependencias base
sudo apt install -y git gcc wget curl build-essential \
    libxslt-dev libzip-dev libldap2-dev libsasl2-dev \
    libjpeg-dev libpq-dev libffi-dev libssl-dev \
    zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
    xz-utils tk-dev libxml2-dev libxmlsec1-dev \
    nginx certbot python3-certbot-nginx \
    postgresql postgresql-contrib nodejs npm

# Instalar Python 3.11.9 desde fuente
cd /usr/src
sudo wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz
sudo tar -xzf Python-${PYTHON_VERSION}.tgz
cd Python-${PYTHON_VERSION}
sudo ./configure --enable-optimizations
sudo make -j$(nproc)
sudo make altinstall
cd ~

# Instalar wkhtmltopdf compatible Ubuntu 22.04
sudo wget https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-2/wkhtmltox_0.12.6.1-2.jammy_amd64.deb
sudo apt install -y ./wkhtmltox_0.12.6.1-2.jammy_amd64.deb

# Configurar PostgreSQL
sudo -u postgres createuser -s odoo

# Crear usuario del sistema
sudo useradd -m -d /opt/odoo -U -r -s /bin/bash odoo
sudo mkdir -p /opt/odoo
sudo chown -R odoo:odoo /opt/odoo

# Clonar Odoo
sudo -u odoo git clone https://www.github.com/odoo/odoo --depth 1 --branch 17.0 /opt/odoo/odoo17

# Crear entorno virtual
sudo -u odoo /usr/local/bin/python3.11 -m venv /opt/odoo/odoo17-venv

sudo -u odoo bash <<EOF
source /opt/odoo/odoo17-venv/bin/activate
pip install --upgrade pip setuptools wheel
pip install -r /opt/odoo/odoo17/requirements.txt
pip install psycopg2-binary
deactivate
EOF

sudo -u odoo mkdir /opt/odoo/odoo17-custom-addons

# Logs
sudo mkdir /var/log/odoo17
sudo chown odoo:odoo /var/log/odoo17

# Archivo configuración
sudo tee /etc/odoo.conf > /dev/null <<EOF
[options]
admin_passwd = CambiaEsto123
db_host = False
db_port = False
db_user = odoo
db_password = False
xmlrpc_port = 8069
longpolling_port = 8072
logfile = /var/log/odoo17/odoo.log
addons_path = /opt/odoo/odoo17/addons,/opt/odoo/odoo17-custom-addons
proxy_mode = True
workers = 3
EOF

# Servicio systemd
sudo tee /etc/systemd/system/odoo17.service > /dev/null <<EOF
[Unit]
Description=Odoo17
After=network.target postgresql.service

[Service]
Type=simple
User=odoo
Group=odoo
ExecStart=/opt/odoo/odoo17-venv/bin/python3.11 /opt/odoo/odoo17/odoo-bin -c /etc/odoo.conf
Restart=always

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable odoo17
sudo systemctl start odoo17

# Configuración Nginx
sudo tee /etc/nginx/sites-available/odoo > /dev/null <<EOF
server {
    listen 80;
    server_name TU_DOMINIO_AQUI;

    location / {
        proxy_pass http://127.0.0.1:8069;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location /websocket {
        proxy_pass http://127.0.0.1:8072;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF

sudo ln -s /etc/nginx/sites-available/odoo /etc/nginx/sites-enabled/
sudo nginx -t
sudo systemctl restart nginx

# UFW Firewall
sudo ufw allow OpenSSH
sudo ufw allow 80
sudo ufw allow 443
sudo ufw --force enable

# Swap 2GB
sudo fallocate -l 2G /swapfile
sudo chmod 600 /swapfile
sudo mkswap /swapfile
sudo swapon /swapfile
echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab

echo "Instalación completada. Reinicia el servidor."
