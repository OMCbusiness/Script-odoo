#!/bin/bash

#
## SCRIPT ADAPTADO PARA Odoo 15 - Python 3.11.9
### Instalación de Odoo, PostgreSQL, Nginx, Firewall y Certbot.
# ODOO_VERSION="15.0"
# POSTGRESQL_VERSION="13"
# Python_version="3.11.9"
#

# -------------------------------
# Actualizar sistema
# -------------------------------
sudo dnf install epel-release dnf-plugins-core -y

# Instalar NGINX y Certbot
sudo dnf install -y certbot nginx

# Carpetas NGINX
sudo mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

# nginx.conf
sudo rm -f /etc/nginx/nginx.conf
sudo sh -c "cat << 'EOF' > /etc/nginx/nginx.conf
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format main '\$remote_addr - \$remote_user [\$time_local] "\$request" '
        '\$status \$body_bytes_sent "\$http_referer" '
        '"\$http_user_agent" "\$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*.conf;
}
EOF"

