#!/bin/bash

#
## SCRIPT HECHO POR Oscar Montero (actualizado)
### Instalación Odoo 18 – AlmaLinux 9 – Producción
#

# 1️⃣ Repos y sistema base
sudo dnf install -y epel-release dnf-plugins-core
sudo dnf config-manager --set-enabled crb
sudo dnf clean all
sudo dnf makecache

# 2️⃣ NGINX + Certbot
sudo dnf install -y nginx certbot
sudo mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

# 3️⃣ nginx.conf
sudo rm -f /etc/nginx/nginx.conf
sudo sh -c "cat << 'EOF' > /etc/nginx/nginx.conf
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events { worker_connections 1024; }

http {
    log_format main '\$remote_addr - \$remote_user [\$time_local] \"\$request\" '
                    '\$status \$body_bytes_sent \"\$http_referer\" '
                    '\"\$http_user_agent\" \"\$http_x_forwarded_for\"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*.conf;
}
EOF"

# 4️⃣ Configuración sitio Odoo en NGINX
sudo sh -c 'cat <<EOF > /etc/nginx/sites-available/odoo.conf
limit_req_zone \$binary_remote_addr zone=ip:10m rate=3r/s;

upstream odoo { server 127.0.0.1:8069; }
upstream odoo-chat { server 127.0.0.1:8072; }

server {
    listen 80;
    server_name <nombre_dns_servidor>;
    limit_req zone=ip burst=60;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <nombre_dns_servidor>;

    ssl_certificate /etc/letsencrypt/live/<nombre_dns_servidor>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<nombre_dns_servidor>/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/<nombre_dns_servidor>/chain.pem;

    ssl_stapling on;
    ssl_stapling_verify on;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=15768000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    resolver 8.8.8.8 8.8.4.4;

    access_log /var/log/nginx/odoo.access.log;
    error_log /var/log/nginx/odoo.error.log;

    client_max_body_size 256M;

    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;

    location / {
        proxy_pass http://odoo;
        proxy_redirect off;
    }

    location /websocket {
        proxy_pass http://127.0.0.1:8072;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /longpolling/ {
        proxy_pass http://127.0.0.1:8072;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ~* /web/static/ {
        proxy_pass http://odoo;
        expires 30d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_types text/css text/less text/plain text/xml application/xml application/json application/javascript;
}
EOF'

sudo ln -s /etc/nginx/sites-available/odoo.conf /etc/nginx/sites-enabled/odoo.conf
sudo systemctl enable nginx
sudo setsebool -P nis_enabled 1

# 5️⃣ Dependencias del sistema + Python 3.12
sudo dnf install -y \
  python3.12 python3.12-devel python3.12-pip \
  gcc gcc-c++ make libffi-devel zlib-devel bzip2-devel \
  git wget libxslt-devel openldap-devel \
  libjpeg-devel freetype-devel \
  postgresql postgresql-server postgresql-devel \
  cyrus-sasl-devel

# 6️⃣ Inicializar PostgreSQL 13
sudo postgresql-setup --initdb
sudo systemctl enable --now postgresql
sudo su - postgres -c "createuser -s odoo"

# 7️⃣ wkhtmltopdf
sudo mkdir -p /opt/odoo
sudo wget -P /opt/odoo \
https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-2/wkhtmltox-0.12.6.1-2.almalinux9.x86_64.rpm
sudo dnf localinstall -y /opt/odoo/wkhtmltox-0.12.6.1-2.almalinux9.x86_64.rpm

# 8️⃣ Usuario Odoo
sudo useradd -m -U -r -d /opt/odoo -s /bin/bash odoo
sudo chown -R odoo:odoo /opt/odoo

# 9️⃣ Odoo 18 + virtualenv
sudo su - odoo -c "git clone https://github.com/odoo/odoo --depth 1 --branch 18.0 /opt/odoo/odoo18"
sudo su - odoo -c "python3.12 -m venv /opt/odoo/odoo18-venv"
sudo su - odoo -c "source /opt/odoo/odoo18-venv/bin/activate && \
pip install --upgrade pip setuptools wheel && \
pip install -r /opt/odoo/odoo18/requirements.txt && \
pip install psycopg2-binary google_auth phonenumbers xlrd openpyxl num2words babel && \ deactivate"

sudo su - odoo -c "mkdir /opt/odoo/odoo18-custom-addons"

# 🔟 Logs
sudo mkdir /var/log/odoo18
sudo touch /var/log/odoo18/odoo.log
sudo chown -R odoo:odoo /var/log/odoo18
sudo chmod -R 755 /var/log/odoo18

# 11️⃣ Configuración Odoo
sudo sh -c 'cat <<EOF > /etc/odoo.conf
[options]
admin_passwd = Iedoo8oo ohPii4ai
db_host = False
db_port = False
db_user = odoo
db_password = False

xmlrpc_port = 8069
longpolling_port = 8072

logfile = /var/log/odoo18/odoo.log
logrotate = True
addons_path = /opt/odoo/odoo18/addons,/opt/odoo/odoo18-custom-addons
proxy_mode = True

workers = 3
max_cron_threads = 1

limit_memory_soft = 1647483648
limit_memory_hard = 1815919104
limit_time_cpu = 60
limit_time_real = 120
EOF'

# 12️⃣ systemd Odoo
sudo sh -c 'cat <<EOF > /etc/systemd/system/odoo18.service
[Unit]
Description=Odoo18
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=odoo
Group=odoo
ExecStart=/opt/odoo/odoo18-venv/bin/python3.12 /opt/odoo/odoo18/odoo-bin -c /etc/odoo.conf
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
EOF'

sudo systemctl daemon-reload
sudo systemctl enable --now odoo18

# 13️⃣ Firewall
sudo dnf install -y firewalld
sudo systemctl enable --now firewalld
sudo firewall-cmd --add-port=80/tcp --permanent
sudo firewall-cmd --add-port=443/tcp --permanent
sudo firewall-cmd --reload

# 14️⃣ Swap 2GB
sudo fallocate -l 2G /swapfile
sudo chmod 600 /swapfile
sudo mkswap /swapfile
sudo swapon /swapfile
echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab

sudo reboot
