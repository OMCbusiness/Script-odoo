#!/bin/bash

#
## SCRIPT HECHO POR Oscar Montero - Producción Odoo 18
### Instalación de Odoo, PostgreSQL, Nginx, Firewall y Certbot
# ODOO_VERSION="18.0"
# POSTGRESQL_VERSION="15"
# PYTHON_VERSION="3.12.1"
#

# Actualizar el sistema
sudo dnf install -y epel-release dnf-plugins-core
sudo dnf update -y

# Instalar NGINX y Certbot
sudo dnf install -y nginx certbot python3-certbot-nginx

# Crear carpetas de configuración NGINX
sudo mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

# Reemplazar nginx.conf
sudo rm -f /etc/nginx/nginx.conf
sudo sh -c "cat << 'EOF' > /etc/nginx/nginx.conf
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 4096;
}

http {
    log_format main '\$remote_addr - \$remote_user [\$time_local] \"\$request\" '
        '\$status \$body_bytes_sent \"\$http_referer\" '
        '\"\$http_user_agent\" \"\$http_x_forwarded_for\"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 4096;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*.conf;
}
EOF"

# Crear archivo dhparam.pem
sudo mkdir -p /etc/cert/certs
sudo openssl dhparam -out /etc/cert/certs/dhparam.pem 2048

# Configuración del sitio Odoo en NGINX
sudo sh -c 'cat <<EOF > /etc/nginx/sites-available/odoo.conf
limit_req_zone \$binary_remote_addr zone=ip:10m rate=5r/s;

upstream odoo {
    server 127.0.0.1:8069;
}

upstream odoo-chat {
    server 127.0.0.1:8072;
}

server {
    listen 80;
    server_name <nombre_dns_servidor>;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <nombre_dns_servidor>;

    ssl_certificate /etc/letsencrypt/live/<nombre_dns_servidor>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<nombre_dns_servidor>/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/<nombre_dns_servidor>/chain.pem;
    ssl_dhparam /etc/cert/certs/dhparam.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 256M;

    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;

    location / {
        proxy_pass http://odoo;
        proxy_redirect off;
    }

    location /websocket {
        proxy_pass http://odoo-chat;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF'

# Activar NGINX
sudo ln -s /etc/nginx/sites-available/odoo.conf /etc/nginx/sites-enabled/odoo.conf
sudo systemctl enable --now nginx
sudo setsebool -P httpd_can_network_connect 1

# Dependencias del sistema
sudo dnf install -y \
git gcc wget nodejs \
libxslt-devel bzip2-devel openldap-devel \
libjpeg-devel freetype-devel \
libsasl2-devel python3-devel \
postgresql-devel gcc-c++

# Instalar Python 3.12
PYTHON_VERSION="3.12.1"
cd /usr/src
sudo dnf groupinstall "Development Tools" -y
sudo dnf install -y zlib-devel readline-devel sqlite-devel openssl-devel xz-devel libffi-devel
sudo wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz
sudo tar xvf Python-${PYTHON_VERSION}.tgz
cd Python-${PYTHON_VERSION}
sudo ./configure --enable-optimizations --prefix=/usr/local
sudo make -j$(nproc)
sudo make altinstall
cd ~

# wkhtmltopdf
sudo mkdir -p /opt/odoo
sudo wget -P /opt/odoo https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-2/wkhtmltox-0.12.6.1-2.almalinux9.x86_64.rpm
sudo dnf localinstall -y /opt/odoo/wkhtmltox-0.12.6.1-2.almalinux9.x86_64.rpm

# PostgreSQL 15
sudo dnf install -y https://download.postgresql.org/pub/repos/yum/reporpms/EL-9-x86_64/pgdg-redhat-repo-latest.noarch.rpm
sudo dnf -qy module disable postgresql
sudo dnf install -y postgresql15-server postgresql15 postgresql15-devel
sudo /usr/pgsql-15/bin/postgresql-15-setup initdb
sudo systemctl enable --now postgresql-15
sudo su - postgres -c "createuser -s odoo"

# Usuario Odoo
sudo useradd -m -U -r -d /opt/odoo -s /bin/bash odoo
sudo chown -R odoo:odoo /opt/odoo

# Odoo 18
sudo su - odoo -c "git clone https://www.github.com/odoo/odoo --depth 1 --branch 18.0 /opt/odoo/odoo18"
sudo su - odoo -c "/usr/local/bin/python3.12 -m venv /opt/odoo/odoo18-venv"
sudo su - odoo -c "source /opt/odoo/odoo18-venv/bin/activate && pip install --upgrade pip setuptools wheel && pip install -r /opt/odoo/odoo18/requirements.txt && deactivate"
sudo su - odoo -c "mkdir /opt/odoo/odoo18-custom-addons"

# Logs
sudo mkdir /var/log/odoo18
sudo touch /var/log/odoo18/odoo.log
sudo chown -R odoo:odoo /var/log/odoo18
sudo chmod -R 750 /var/log/odoo18

# Configuración Odoo (OPTIMIZADA 4C / 8GB)
sudo sh -c 'cat <<EOF > /etc/odoo.conf
[options]
admin_passwd = CambiarPasswordSeguro

db_host = False
db_port = False
db_user = odoo
db_password = False

xmlrpc_port = 8069
longpolling_port = 8072

proxy_mode = True

workers = 7
max_cron_threads = 1

limit_memory_soft = 4294967296
limit_memory_hard = 5368709120

limit_time_cpu = 60
limit_time_real = 120

logfile = /var/log/odoo18/odoo.log
logrotate = True

addons_path = /opt/odoo/odoo18/addons,/opt/odoo/odoo18-custom-addons
EOF'

# Servicio systemd
sudo sh -c 'cat <<EOF > /etc/systemd/system/odoo18.service
[Unit]
Description=Odoo18
After=network.target postgresql-15.service

[Service]
Type=simple
User=odoo
Group=odoo
ExecStart=/opt/odoo/odoo18-venv/bin/python3.12 /opt/odoo/odoo18/odoo-bin -c /etc/odoo.conf
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF'

# Activar servicio
sudo systemctl daemon-reload
sudo systemctl enable --now odoo18

# Firewall
sudo dnf install -y firewalld
sudo systemctl enable --now firewalld
sudo firewall-cmd --add-service=http --add-service=https --permanent
sudo firewall-cmd --reload

# Swap
sudo fallocate -l 2G /swapfile
sudo chmod 600 /swapfile
sudo mkswap /swapfile
sudo swapon /swapfile
echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab

# Permisos finales
sudo chown -R odoo:odoo /opt/odoo
sudo chmod -R 755 /opt/odoo
sudo reboot
